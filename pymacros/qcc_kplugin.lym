<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>Quantcore circuits: menu, tools and command server</description>
 <version/>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <priority>10</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text>import pya
from qcc_kplugin import menu, pcells, server, tools

menu.build()  # six submenus (Design, Edit, Check and LOM, Simulate, Results, Fab) + panel + Settings
tools.register_tools()
pcells.startup()  # Settings > live PCells (off by default): the Quantcore library for KLayout's Instance tool
server.start_server()
</text>
</klayout-macro>
